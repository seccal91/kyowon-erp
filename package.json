  { name: '경기본부', 회원수: 4850, 전월비: 320, 목표치: 5000 },
  { name: '충청본부', 회원수: 3100, 전월비: 150, 목표치: 3500 },
  { name: '영남본부', 회원수: 4200, 전월비: -120, 목표치: 4500 },
